@import "tailwindcss";

@layer theme {
    :root {
        --background: 240 10% 3.9%;
        --foreground: 0 0% 98%;
        --primary: 263.4 70% 50.4%;
        --primary-foreground: 210 40% 98%;
        --secondary: 217.2 32.6% 17.5%;
        --secondary-foreground: 210 40% 98%;
        --accent: 262 80% 50%;
        /* Vibrant Purple */
        --accent-foreground: 210 40% 98%;
        --muted: 217.2 32.6% 17.5%;
        --muted-foreground: 215 20.2% 65.1%;
        --popover: 222.2 84% 4.9%;
        --popover-foreground: 210 40% 98%;
        --card: 222.2 84% 4.9%;
        --card-foreground: 210 40% 98%;
        --border: 217.2 32.6% 17.5%;
        --input: 217.2 32.6% 17.5%;
        --ring: 263.4 70% 50.4%;
        --radius: 0.75rem;
    }
}

@theme inline {
    --color-border: hsl(var(--border));
    --color-input: hsl(var(--input));
    --color-ring: hsl(var(--ring));
    --color-background: hsl(var(--background));
    --color-foreground: hsl(var(--foreground));
    --color-primary: hsl(var(--primary));
    --color-primary-foreground: hsl(var(--primary-foreground));
    --color-secondary: hsl(var(--secondary));
    --color-secondary-foreground: hsl(var(--secondary-foreground));
    --color-muted: hsl(var(--muted));
    --color-muted-foreground: hsl(var(--muted-foreground));
    --color-accent: hsl(var(--accent));
    --color-accent-foreground: hsl(var(--accent-foreground));
    --color-popover: hsl(var(--popover));
    --color-popover-foreground: hsl(var(--popover-foreground));
    --color-card: hsl(var(--card));
    --color-card-foreground: hsl(var(--card-foreground));

    --font-heading: 'Outfit', sans-serif;
    --font-body: 'Inter', sans-serif;

    --animate-aurora: aurora 60s linear infinite;

    @keyframes aurora {
        from {
            background-position: 50% 50%, 50% 50%;
        }

        to {
            background-position: 350% 50%, 350% 50%;
        }
    }
}

/* Custom Utilities */
@layer utilities {
    .glass-panel {
        @apply bg-white/5 backdrop-blur-md border border-white/10 shadow-xl;
    }

    .text-gradient {
        @apply bg-clip-text text-transparent bg-gradient-to-r from-violet-400 via-fuchsia-400 to-cyan-400;
    }

    .aurora-bg {
        background-image:
            radial-gradient(at 100% 0%, hsla(249, 100%, 76%, 0.2) 0px, transparent 50%),
            radial-gradient(at 0% 0%, hsla(280, 100%, 76%, 0.2) 0px, transparent 50%);
    }
}

/* Base Styles */
body {
    @apply bg-background text-foreground font-body antialiased;
    background-color: #030014;
    /* Deep space black */
    overflow-x: hidden;
}

h1,
h2,
h3,
h4,
h5,
h6 {
    @apply font-heading font-bold;
}

/* Custom Scrollbar */
::-webkit-scrollbar {
    width: 10px;
}

::-webkit-scrollbar-track {
    background: #0f172a;
}

::-webkit-scrollbar-thumb {
    background: #334155;
    border-radius: 5px;
}

::-webkit-scrollbar-thumb:hover {
    background: #475569;
}